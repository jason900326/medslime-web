# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Canonical public site URL used for production payment callbacks
NEXT_PUBLIC_SITE_URL=https://medslime.vercel.app

# ECPay AioCheckOut
# Keep HashKey / HashIV server-side only. Never expose them with NEXT_PUBLIC_.
ECPAY_MERCHANT_ID=your-merchant-id
ECPAY_HASH_KEY=your-hash-key
ECPAY_HASH_IV=your-hash-iv
# stage | production
ECPAY_MODE=stage

# Preview-stage safety:
# - Stage checkout is restricted to this comma-separated email allowlist.
# - On Vercel Preview, callback URLs automatically use the current preview URL.
# - Set PAYMENT_CALLBACK_BASE_URL only when you intentionally need a fixed override.
PAYMENT_STAGE_TEST_EMAILS=jason@example.com
PAYMENT_CALLBACK_BASE_URL=
# Optional dedicated secret for /api/internal/payments/readiness.
# If omitted, TAXONOMY_ADMIN_SECRET is accepted as a backwards-compatible admin secret.
PAYMENT_ADMIN_SECRET=

# ECPay integration availability.
NEXT_PUBLIC_ECPAY_ENABLED=false

# Storefront checkout release gate.
# Production: keep BOTH false while the payment provider is reviewing the merchant account.
# Preview stage test: set both true only in the Preview environment, together with ECPAY_MODE=stage.
NEXT_PUBLIC_SHOP_CHECKOUT_ENABLED=false
SHOP_CHECKOUT_ENABLED=false
